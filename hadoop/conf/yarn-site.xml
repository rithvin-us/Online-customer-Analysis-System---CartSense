<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>
<!--
  CartScope yarn-site.xml template.

  The cluster runs three NodeManagers on one development machine, so the
  container sizes here are small on purpose: 2 GiB of schedulable memory per
  NodeManager (6 GiB cluster-wide) with 512 MiB task containers. That is
  enough for four concurrent tasks per worker, which is what makes the
  distribution of map tasks across workers observable.
-->
<configuration>

  <property>
    <name>yarn.resourcemanager.hostname</name>
    <value>${CARTSCOPE_RM_HOST}</value>
  </property>
  <property>
    <name>yarn.resourcemanager.bind-host</name>
    <value>0.0.0.0</value>
  </property>
  <property>
    <name>yarn.resourcemanager.webapp.address</name>
    <value>${CARTSCOPE_RM_HOST}:8088</value>
  </property>
  <property>
    <name>yarn.nodemanager.bind-host</name>
    <value>0.0.0.0</value>
  </property>

  <property>
    <name>yarn.nodemanager.aux-services</name>
    <value>mapreduce_shuffle</value>
  </property>
  <property>
    <name>yarn.nodemanager.aux-services.mapreduce_shuffle.class</name>
    <value>org.apache.hadoop.mapred.ShuffleHandler</value>
  </property>

  <!-- Per-worker resources. -->
  <property>
    <name>yarn.nodemanager.resource.memory-mb</name>
    <value>${CARTSCOPE_NM_MEMORY_MB}</value>
  </property>
  <property>
    <name>yarn.nodemanager.resource.cpu-vcores</name>
    <value>${CARTSCOPE_NM_VCORES}</value>
  </property>

  <!-- Container allocation bounds. -->
  <property>
    <name>yarn.scheduler.minimum-allocation-mb</name>
    <value>256</value>
  </property>
  <property>
    <name>yarn.scheduler.maximum-allocation-mb</name>
    <value>${CARTSCOPE_NM_MEMORY_MB}</value>
  </property>
  <property>
    <name>yarn.scheduler.minimum-allocation-vcores</name>
    <value>1</value>
  </property>
  <property>
    <name>yarn.scheduler.maximum-allocation-vcores</name>
    <value>${CARTSCOPE_NM_VCORES}</value>
  </property>

  <property>
    <name>yarn.nodemanager.vmem-check-enabled</name>
    <value>false</value>
    <description>
      A 512 MiB JVM reserves far more than 512 MiB of virtual address space on
      a 64-bit host, so the default 2.1x virtual memory check would kill
      healthy containers. Physical memory is still enforced.
    </description>
  </property>
  <property>
    <name>yarn.nodemanager.pmem-check-enabled</name>
    <value>true</value>
  </property>

  <property>
    <name>yarn.nodemanager.local-dirs</name>
    <value>/hadoop/yarn/local</value>
  </property>
  <property>
    <name>yarn.nodemanager.log-dirs</name>
    <value>/hadoop/yarn/logs</value>
  </property>

  <!--
    Log aggregation is enabled so that CartScope can show the real stdout,
    stderr and syslog of each map and reduce attempt. The UI never generates
    log text: it reads these aggregated logs through the JobHistoryServer.
  -->
  <property>
    <name>yarn.log-aggregation-enable</name>
    <value>true</value>
  </property>
  <property>
    <name>yarn.nodemanager.remote-app-log-dir</name>
    <value>/cartscope/yarn-logs</value>
  </property>
  <property>
    <name>yarn.log-aggregation.retain-seconds</name>
    <value>604800</value>
  </property>
  <property>
    <name>yarn.log.server.url</name>
    <value>http://${CARTSCOPE_HISTORY_HOST}:19888/jobhistory/logs</value>
  </property>

  <!-- Keep finished applications queryable by the RM REST API for a while. -->
  <property>
    <name>yarn.resourcemanager.max-completed-applications</name>
    <value>1000</value>
  </property>
  <property>
    <name>yarn.resourcemanager.nodemanagers.heartbeat-interval-ms</name>
    <value>1000</value>
  </property>

  <property>
    <name>yarn.application.classpath</name>
    <value>$HADOOP_CONF_DIR,$HADOOP_HOME/share/hadoop/common/*,$HADOOP_HOME/share/hadoop/common/lib/*,$HADOOP_HOME/share/hadoop/hdfs/*,$HADOOP_HOME/share/hadoop/hdfs/lib/*,$HADOOP_HOME/share/hadoop/mapreduce/*,$HADOOP_HOME/share/hadoop/mapreduce/lib/*,$HADOOP_HOME/share/hadoop/yarn/*,$HADOOP_HOME/share/hadoop/yarn/lib/*</value>
  </property>

</configuration>
