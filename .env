# ---------------------------------------------------------------------------
# CartScope local cluster profile.
#
# This file configures a multi-container Hadoop cluster running on ONE
# physical development machine. It is not a cluster of three separate
# computers; see docs/ARCHITECTURE.md.
# ---------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=cartscope

# --- Versions (pinned) ------------------------------------------------------
HADOOP_VERSION=3.5.0
POSTGRES_VERSION=16.4
REDIS_VERSION=7.4

# --- HDFS -------------------------------------------------------------------
# Replication factor 2 across three DataNodes.
CARTSCOPE_HDFS_REPLICATION=2
# 4 MiB blocks. Deliberately small for the local demonstration profile so the
# UCI Online Retail dataset spans many blocks and therefore many map input
# splits. Raise to 134217728 (128 MiB) for a production-like profile.
CARTSCOPE_HDFS_BLOCK_SIZE=4194304

# --- YARN worker sizing -----------------------------------------------------
# 3 NodeManagers x 2048 MiB = 6144 MiB of schedulable cluster memory.
CARTSCOPE_NM_MEMORY_MB=2048
CARTSCOPE_NM_VCORES=2

# --- MapReduce container sizing --------------------------------------------
CARTSCOPE_MAP_MEMORY_MB=512
CARTSCOPE_MAP_HEAP_MB=410
CARTSCOPE_REDUCE_MEMORY_MB=512
CARTSCOPE_REDUCE_HEAP_MB=410
CARTSCOPE_AM_MEMORY_MB=768
CARTSCOPE_AM_HEAP_MB=614

# --- Default reducer counts -------------------------------------------------
# Three reducers by default: one per worker, so the reduce phase is also
# visibly distributed.
CARTSCOPE_DEFAULT_REDUCERS=3

# --- Datastores -------------------------------------------------------------
POSTGRES_USER=cartscope
POSTGRES_PASSWORD=cartscope_dev_password
POSTGRES_DB=cartscope
POSTGRES_HOST_PORT=55432

REDIS_HOST_PORT=56379

# --- Application ------------------------------------------------------------
API_HOST_PORT=8000
FRONTEND_HOST_PORT=3000
CARTSCOPE_MAX_UPLOAD_MB=512
CARTSCOPE_LOG_LEVEL=INFO

# --- Hadoop web UI ports on the host ---------------------------------------
NAMENODE_UI_PORT=9870
RESOURCEMANAGER_UI_PORT=8088
HISTORYSERVER_UI_PORT=19888
